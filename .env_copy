# ----------------------------------------------------------------------------
# App runtime
# ----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_NAME=FastAPI Vibe Coding
BACKEND_CORS_ORIGINS=*

# Uvicorn (optional; script has sane defaults)
# HOST=0.0.0.0
# PORT=8000
# WORKERS=1
# RELOAD=true

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Default to local SQLite (async) for zero-setup dev
DATABASE_URL=sqlite+aiosqlite:///./app.db

# For Postgres (async) running locally or via Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_vibe_coding

# If using docker-compose's Postgres service, these are read by compose:
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=fastapi_vibe_coding

# The app uses DATABASE_HOST from docker-compose to point to the DB container.
# For local non-docker runs, leave it unset or set to localhost.
DATABASE_HOST=localhost

# ----------------------------------------------------------------------------
# Redis (optional)
# ----------------------------------------------------------------------------
# Option 1: Use full Redis URL (takes precedence)
# REDIS_URL=redis://:password@localhost:6379/0

# Option 2: Use discrete credentials (will be assembled into URL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis
